PORT=3000
DATABASE_URL=postgres://benefitsgraph:benefitsgraph@localhost:5432/benefitsgraph
REDIS_URL=redis://localhost:6379
INSURER_SERVICE_URL=http://localhost:4001
PROVIDER_SERVICE_URL=http://localhost:4002
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Tighter budget for POST /auth/guest — it is unauthenticated and creates a row.
AUTH_RATE_LIMIT_MAX=10
# Guest sandboxes (and all their data) are pruned this long after last use.
SANDBOX_RETENTION_HOURS=48
LOG_LEVEL=info
